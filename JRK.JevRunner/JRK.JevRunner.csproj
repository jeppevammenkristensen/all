<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JRK.JevRunner</RootNamespace>
    <PackageId>JRK.JevRunner</PackageId>
    <Version>0.0.3</Version>
    <Title>JRK JevRunner</Title>
    <Authors>Jeppe Roi Kristensen</Authors>
    <Description>Unofficial .NET client for Jev and the TypeSafe System One API. Submit application state and named questions, and consume typed responses.</Description>
    <PackageTags>jev;typesafe;ai;system-one;api-client;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Runner-Icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JRK.JevRunner.Tests" />
  </ItemGroup> 

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Update="assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
  </ItemGroup>

</Project>
